/node_modules
/.pnp
.pnp.js

# testing
/coverage

# database
/prisma/db.sqlite
/prisma/db.sqlite-journal
db.sqlite

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# do not commit any .env files to git, except for the .env.example file. https://create.t3.gg/en/usage/env-variables#using-environment-variables
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo

# idea files
.idea

# Playwright MCP server (browser automation)
.playwright-mcp

# Claude Code
.claude/settings.local.json
.claude/conversations/
.claude/worktrees/
CLAUDE.local.md

# Git worktrees
.worktrees/

# mvp-builder: raw uploaded案件資料（議事録・Excel・PDF等）。顧客の機密情報を含みうるため常にgit管理外とする
/inputs/
.env*

# ローカル専用の完全版ドキュメント（リポジトリには抜粋のみ置く）
*.local.md

# キックオフ資料（11MB のバイナリ）は git 管理外
docs/poc-reference/*.pptx

# CI レビュー用の生成データ（claude-review.yml が作成）
.review-data/

# 操作動画（容量が大きいためGitに入れない。字幕とレポートは入れる）
docs/demo/*.mp4
docs/demo/*.webm
