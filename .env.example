# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Supabase connection string (Connection Pooler / Transaction mode, port 6543).
# Supabase Dashboard > Project Settings > Database > Connection string > "Transaction".
# Same instance as the existing construct-pro app — no data migration.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# JWT signing secret (required). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email sending (invoice / purchase order send, invitations, password reset)
# テスト用: Gmail のアプリパスワード（2段階認証を有効にして発行）を SMTP_PASS に設定する。
#   SMTP_USER=テスト用Gmailアドレス / SMTP_PASS=アプリパスワード（16桁）
#   MAIL_FROM を省略すると、差出人は SMTP_USER のアドレスになる。
# 独自ドメイン取得後: SMTP_HOST/PORT/USER/PASS を新しいメールサービスに替え、MAIL_FROM を
#   「CONSTRUCT_PRO <noreply@取得したドメイン>」に設定する（SPF/DKIM の設定も必要）。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
